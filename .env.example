# ==========================================
# Homelab Server - Docker Environment Config
# ==========================================

ADMIN_USERNAME=admin

# Generate a strong JWT Secret:
# Linux/macOS: openssl rand -base64 64
# Windows PowerShell: [Convert]::ToBase64String((1..64 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
JWT_SECRET=replace_with_a_secure_random_base64_secret_key_at_least_32_chars

# Generate admin password hash (bcrypt):
# htpasswd -bnBC 10 "" "your-password" | tr -d ':\n'
ADMIN_PASSWORD_HASH=replace_with_admin_bcrypt_password_hash
